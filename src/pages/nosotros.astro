---
import Layout from "../layouts/Layout.astro";
import Container from "../components/common/Container.astro";
import Button from "../components/ui/Button.astro";

import {
  Target,
  Eye,
  ShieldCheck,
  Users,
  Clock3,
  Leaf,
} from "lucide-astro";

import { companyValues } from "../data/company";

import "../styles/pages/nosotros.css";

const valueIcons = {
  shield: ShieldCheck,
  users: Users,
  clock: Clock3,
  leaf: Leaf,
};
---

<Layout
  title="Nosotros | CIRCROM"
  description="Conoce más sobre CIRCROM, nuestra forma de trabajar, misión, visión y compromiso con cada proyecto."
>
  <main>
    <!-- Hero -->
    <section class="about-page__hero">
      <Container class="container--wide">
        <div class="about-page__hero-grid">
          <div class="about-page__hero-content">
            <p class="about-page__eyebrow">
              Nosotros
            </p>

            <h1 class="about-page__hero-title">
              Construimos espacios. Construimos confianza.
            </h1>

            <p class="about-page__hero-description">
              En CIRCROM desarrollamos soluciones integrales en construcción,
              remodelación, supervisión y planeación, trabajando con compromiso,
              calidad y atención a cada detalle.
            </p>
          </div>

            <div class="about-page__hero-visual">
              <img
              class="about-page__hero-image"
              src="/images/about/cir-temp.jpg"
              alt="Equipo y proyectos de CIRCROM"
              loading="eager"
              />
            </div>
          </div>
      </Container>
    </section>

    <!-- Quiénes somos -->
    <section class="about-page__intro section">
      <Container class="container--wide">
        <div class="about-page__intro-grid">
          <div>
            <p class="about-page__eyebrow">
              Quiénes somos
            </p>

            <h2 class="about-page__section-title">
              Soluciones construidas alrededor de cada proyecto
            </h2>
          </div>

          <div class="about-page__intro-copy">
            <p>
              CIRCROM es una empresa enfocada en el desarrollo de proyectos de
              construcción y remodelación, ofreciendo soluciones adaptadas a las
              necesidades de cada cliente.
            </p>

            <p>
              Nuestro trabajo integra planeación, ejecución y supervisión para
              desarrollar espacios funcionales, confiables y de calidad.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Dirección general -->
    <section class="about-page__leadership section">
      <Container class="container--wide">
        <div class="about-page__leadership-grid">
            <div class="about-page__portrait">
                <img
                class="about-page__portrait-image"
                src="/images/about/arqui-prueba.png"
                alt="Director General de CIRCROM"
                loading="lazy"
                />
            </div>

          <div class="about-page__leadership-content">
            <p class="about-page__eyebrow">
              Dirección general
            </p>

            <h2 class="about-page__section-title">
              Liderazgo con experiencia y compromiso
            </h2>

            <div class="about-page__director">
              <h3>
                Luis Guzmán
              </h3>

              <p class="about-page__director-role">
                Director General
              </p>
            </div>

            <p class="about-page__leadership-description">
              *trayectoria / presentacion arqui*
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Misión y visión -->
    <section class="about-page__purpose section">
      <Container class="container--wide">
        <div class="about-page__purpose-grid">
          <article class="about-page__purpose-card">
            <div class="about-page__purpose-icon">
              <Target
                size={30}
                strokeWidth={1.8}
                aria-hidden="true"
              />
            </div>

            <p class="about-page__eyebrow">
              Misión
            </p>

            <h2 class="about-page__purpose-title">
              Construir soluciones que generen valor
            </h2>

            <p class="about-page__purpose-description">
              Texto provisional.
            </p>
          </article>

          <article class="about-page__purpose-card">
            <div class="about-page__purpose-icon">
              <Eye
                size={30}
                strokeWidth={1.8}
                aria-hidden="true"
              />
            </div>

            <p class="about-page__eyebrow">
              Visión
            </p>

            <h2 class="about-page__purpose-title">
              Seguir creciendo a través de proyectos de calidad
            </h2>

            <p class="about-page__purpose-description">
              Texto provisional.
            </p>
          </article>
        </div>
      </Container>
    </section>

    <!-- Valores -->
    <section class="about-page__values section">
      <Container class="container--wide">
        <div class="about-page__values-heading">
          <p class="about-page__eyebrow">
            Nuestros valores
          </p>

          <h2 class="about-page__section-title">
            Principios que guían nuestro trabajo
          </h2>
        </div>

        <div class="about-page__values-grid">
          {
            companyValues.map((value) => {
              const Icon =
                valueIcons[value.icon as keyof typeof valueIcons];

              return (
                <article class="about-page__value-card">
                  <div
                    class="about-page__value-icon"
                    aria-hidden="true"
                  >
                    <Icon
                      size={28}
                      strokeWidth={1.8}
                      absoluteStrokeWidth
                    />
                  </div>

                  <h3>
                    {value.title}
                  </h3>

                  <p>
                    {value.description}
                  </p>
                </article>
              );
            })
          }
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="about-page__cta section">
      <Container class="container--wide">
        <div class="about-page__cta-content">
          <div>
            <p class="about-page__eyebrow">
              ¿Tienes un proyecto?
            </p>

            <h2 class="about-page__section-title">
              Hablemos de tu próximo proyecto
            </h2>

            <p class="about-page__cta-description">
              Cuéntanos qué necesitas y conozcamos cómo CIRCROM puede ayudarte.
            </p>
          </div>

          <Button href="/#contacto" size="lg">
            Contactar a CIRCROM
          </Button>
        </div>
      </Container>
    </section>
  </main>
</Layout>