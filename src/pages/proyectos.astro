---
import Layout from "../layouts/Layout.astro";
import Container from "../components/common/Container.astro";
import Button from "../components/ui/Button.astro";

import { ChevronLeft, ChevronRight } from "lucide-astro";

import { portfolioProjects } from "../data/portfolioProjects";

import "../styles/pages/proyectos.css";
import "../styles/animations/proyectos-animations.css";
---

<Layout
  title="Proyectos | CIRCROM"
  description="Conoce algunos de los proyectos desarrollados por CIRCROM y descubre nuestro trabajo a través de cada obra."
>
  <main>
    <!-- Hero -->
    <section class="portfolio-page__hero">
      <Container class="container--wide">
        <div class="portfolio-page__hero-content">
          <p class="portfolio-page__eyebrow">Proyectos</p>

          <h1 class="portfolio-page__hero-title">
            Obras que hablan por nuestro trabajo
          </h1>

          <p class="portfolio-page__hero-description">
            Conoce algunos de los proyectos desarrollados por CIRCROM y descubre
            los detalles detrás de cada obra.
          </p>
        </div>
      </Container>
    </section>

    <!-- Lista de proyectos -->
    <section class="portfolio-page__projects section">
      <Container class="container--wide">
        <div class="portfolio-page__list">
          {
            portfolioProjects.map((project, index) => (
              <details class="portfolio-project">
                <summary class="portfolio-project__summary">
                  <span class="portfolio-project__number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <h2 class="portfolio-project__name">{project.name}</h2>

                  <span class="portfolio-project__toggle" aria-hidden="true">
                    +
                  </span>
                </summary>

                <div class="portfolio-project__content">
                  {(project.description ||
                    project.location ||
                    project.year) && (
                    <div class="portfolio-project__info">
                      {project.description && (
                        <p class="portfolio-project__description">
                          {project.description}
                        </p>
                      )}

                      {(project.location || project.year) && (
                        <dl class="portfolio-project__meta">
                          {project.location && (
                            <div>
                              <dt>Ubicación</dt>
                              <dd>{project.location}</dd>
                            </div>
                          )}

                          {project.year && (
                            <div>
                              <dt>Año</dt>
                              <dd>{project.year}</dd>
                            </div>
                          )}
                        </dl>
                      )}
                    </div>
                  )}

                  <div class="portfolio-carousel" data-carousel>
                    <div class="portfolio-carousel__viewport">
                      {project.images.map((image, imageIndex) => (
                        <figure
                          class:list={[
                            "portfolio-carousel__slide",
                            {
                              "is-active": imageIndex === 0,
                            },
                          ]}
                          data-carousel-slide
                        >
                          <img
                            src={image}
                            alt={`${project.name} - fotografía ${imageIndex + 1}`}
                            loading="lazy"
                          />
                        </figure>
                      ))}

                      {project.images.length > 1 && (
                        <>
                          <button
                            class="portfolio-carousel__button portfolio-carousel__button--prev"
                            type="button"
                            data-carousel-prev
                            aria-label={`Ver fotografía anterior de ${project.name}`}
                          >
                            <ChevronLeft
                              size={28}
                              strokeWidth={1.8}
                              aria-hidden="true"
                            />
                          </button>

                          <button
                            class="portfolio-carousel__button portfolio-carousel__button--next"
                            type="button"
                            data-carousel-next
                            aria-label={`Ver siguiente fotografía de ${project.name}`}
                          >
                            <ChevronRight
                              size={28}
                              strokeWidth={1.8}
                              aria-hidden="true"
                            />
                          </button>
                        </>
                      )}
                    </div>

                    {project.images.length > 1 && (
                      <div
                        class="portfolio-carousel__counter"
                        aria-live="polite"
                      >
                        <span data-carousel-current>1</span>

                        <span aria-hidden="true">/</span>

                        <span>{project.images.length}</span>
                      </div>
                    )}
                  </div>
                </div>
              </details>
            ))
          }
        </div>
      </Container>
    </section>

    <!-- Marcas -->
    <section class="portfolio-page__brands section" data-reveal>
      <Container class="container--wide">
        <div class="portfolio-page__brands-header">
          <p class="portfolio-page__eyebrow">Experiencia</p>

          <h2 class="portfolio-page__brands-title">
            Marcas que han confiado en nuestro trabajo
          </h2>

          <p class="portfolio-page__brands-description">
            Hemos colaborado en proyectos para algunas de las principales marcas
            automotrices presentes en México.
          </p>
        </div>

        <div class="portfolio-page__brands-grid">
          <div class="portfolio-page__brand">
            <img
              src="/images/brands/mercedes-benz.png"
              alt="Mercedes-Benz"
              loading="lazy"
            />
          </div>

          <div class="portfolio-page__brand">
            <img src="/images/brands/toyota.png" alt="Toyota" loading="lazy" />
          </div>

          <div class="portfolio-page__brand">
            <img
              src="/images/brands/chevrolet.png"
              alt="Chevrolet"
              loading="lazy"
            />
          </div>

          <div class="portfolio-page__brand">
            <img src="/images/brands/byd.png" alt="BYD" loading="lazy" />
          </div>

          <div class="portfolio-page__brand">
            <img src="/images/brands/geely.png" alt="Geely" loading="lazy" />
          </div>

          <div class="portfolio-page__brand">
            <img src="/images/brands/kia.png" alt="KIA" loading="lazy" />
          </div>

          <div class="portfolio-page__brand">
            <img
              src="/images/brands/stellantis.png"
              alt="Stellantis"
              loading="lazy"
            />
          </div>

          <div class="portfolio-page__brand">
            <img src="/images/brands/nissan.png" alt="Nissan" loading="lazy" />
          </div>

          <div class="portfolio-page__brand">
            <img
              src="/images/brands/hyundai.png"
              alt="Hyundai"
              loading="lazy"
            />
          </div>
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="portfolio-page__cta section" data-reveal>
      <Container class="container--wide">
        <div class="portfolio-page__cta-content">
          <div class="portfolio-page__cta-text">
            <p class="portfolio-page__eyebrow">¿Tienes un proyecto?</p>

            <h2 class="portfolio-page__cta-title">
              Hablemos de tu próximo proyecto
            </h2>

            <p class="portfolio-page__cta-description">
              Cuéntanos qué necesitas y conozcamos cómo CIRCROM puede ayudarte.
            </p>
          </div>

          <Button href="/#contacto" size="lg"> Contactar a CIRCROM </Button>
        </div>
      </Container>
    </section>
  </main>

  <script>
    import "../scripts/projectCarousel.js";
    import "../scripts/projectAccordion.js";
    import "../scripts/scrollReveal.js";
  </script>
</Layout>
