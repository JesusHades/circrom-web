---
import Container from "../common/Container.astro";
import SectionTitle from "../common/SectionTitle.astro";
import Card from "../ui/Card.astro";

import {
  Building2,
  PaintRoller,
  ClipboardCheck,
  Compass,
} from "lucide-astro";

import { services } from "../../data/services";

const serviceIcons = [
  Building2,
  PaintRoller,
  ClipboardCheck,
  Compass,
];
---

<section class="services section" id="servicios">
  <Container class="container--wide">
    <SectionTitle
      eyebrow="Nuestros servicios"
      title="Soluciones integrales para cada proyecto"
      description="Ofrecemos servicios adaptados a las necesidades de cada cliente, desde la planeación hasta la ejecución."
    />

    <div class="services__grid">
      {
        services.map((service, index) => {
          const Icon = serviceIcons[index];

          return (
            <Card hover class="services__card">
              <div class="services__icon" aria-hidden="true">
                <Icon
                  size={30}
                  strokeWidth={1.8}
                  absoluteStrokeWidth
                />
              </div>

              <h3 class="services__title">
                {service.title}
              </h3>

              <p class="services__description">
                {service.description}
              </p>
            </Card>
          );
        })
      }
    </div>
  </Container>
</section>

<style>
  .services {
    background-color: var(--color-white);
  }

  .services__grid {
    display: grid;
    gap: var(--space-6);

    margin-top: var(--space-7);
  }

  .services__card {
    height: 100%;
  }

  .services__icon {
    display: grid;
    place-items: center;

    width: 3.5rem;
    height: 3.5rem;

    margin-bottom: var(--space-5);

    background-color: var(--color-secondary-light);
    border-radius: var(--radius-md);

    color: var(--color-secondary);
  }

  .services__title {
    margin-bottom: var(--space-3);

    font-size: var(--font-size-lg);
  }

  .services__description {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .services__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>