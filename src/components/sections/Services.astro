---
import "../../styles/components/services.css";

import Container from "../common/Container.astro";
import SectionTitle from "../common/SectionTitle.astro";
import Card from "../ui/Card.astro";

import {
  Building2,
  PaintRoller,
  ClipboardCheck,
  Compass,
} from "lucide-astro";

import { services } from "../../data/services";

const serviceIcons = [
  Building2,
  PaintRoller,
  ClipboardCheck,
  Compass,
];
---

<section class="services section" id="servicios">
  <Container class="container--wide">
    <SectionTitle
      eyebrow="Nuestros servicios"
      title="Soluciones integrales para cada proyecto"
      description="Ofrecemos servicios adaptados a las necesidades de cada cliente, desde la planeación hasta la ejecución."
    />

    <div class="services__grid">
      {
        services.map((service, index) => {
          const Icon = serviceIcons[index];

          return (
            <Card hover class="services__card">
              <div class="services__icon" aria-hidden="true">
                <Icon
                  size={30}
                  strokeWidth={1.8}
                  absoluteStrokeWidth
                />
              </div>

              <h3 class="services__title">
                {service.title}
              </h3>

              <p class="services__description">
                {service.description}
              </p>
            </Card>
          );
        })
      }
    </div>
  </Container>
</section>