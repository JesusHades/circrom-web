---
import "../../styles/components/contact.css";

import Container from "../common/Container.astro";
import SectionTitle from "../common/SectionTitle.astro";

import {
  Phone,
  Mail,
  MapPin,
  MessageCircle,
  Send,
} from "lucide-astro";
---

<section
  class="contact section"
  id="contacto"
  data-reveal
>
  <Container class="container--wide">

    <div class="contact__heading">
      <SectionTitle
        eyebrow="Contacto"
        title="Hablemos de tu próximo proyecto"
        description="Cuéntanos qué necesitas. Podemos ayudarte con proyectos de construcción, remodelación, supervisión y adecuación de espacios."
      />
    </div>

    <div class="contact__grid">
      <div class="contact__info">
        <article class="contact__item">
          <div class="contact__icon" aria-hidden="true">
            <Phone size={24} strokeWidth={1.8} />
          </div>

          <div>
            <span class="contact__label">Teléfono</span>
            <p>+52 55 5359 2082</p>
          </div>
        </article>

        <article class="contact__item">
          <div class="contact__icon" aria-hidden="true">
            <Mail size={24} strokeWidth={1.8} />
          </div>

          <div>
            <span class="contact__label">Correo</span>

            <a
              class="contact__value"
              href="mailto:contactocirc2025@gmail.com"
            >
              contactocirc2025@gmail.com
            </a>
          </div>
        </article>

        <article class="contact__item">
          <div class="contact__icon" aria-hidden="true">
            <MapPin size={24} strokeWidth={1.8} />
          </div>

          <div>
            <span class="contact__label">Ubicación</span>

            <p class="contact__value">
              Azcapotzalco, Ciudad de México, México
            </p>
          </div>
        </article>

        <article class="contact__item">
          <div class="contact__icon" aria-hidden="true">
            <MessageCircle size={24} strokeWidth={1.8} />
          </div>

          <div>
            <span class="contact__label">WhatsApp</span>

            <a
              class="contact__value contact__value--link"
              href="https://wa.me/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Iniciar conversación
            </a>
          </div>
        </article>
      </div>

      <form class="contact__form">
        <div class="contact__field">
          <label for="name">Nombre</label>

          <input
            id="name"
            name="name"
            type="text"
            placeholder="Tu nombre"
            autocomplete="name"
          />
        </div>

        <div class="contact__row">
          <div class="contact__field">
            <label for="email">Correo electrónico</label>

            <input
              id="email"
              name="email"
              type="email"
              placeholder="correo@ejemplo.com"
              autocomplete="email"
            />
          </div>

          <div class="contact__field">
            <label for="phone">Teléfono</label>

            <input
              id="phone"
              name="phone"
              type="tel"
              placeholder="+52..."
              autocomplete="tel"
            />
          </div>
        </div>

        <div class="contact__field">
          <label for="project-type">
            Tipo de proyecto
          </label>

          <select
            id="project-type"
            name="project-type"
          >
            <option value="">
              Selecciona una opción
            </option>

            <option value="construccion">
              Construcción
            </option>

            <option value="remodelacion">
              Remodelación
            </option>

            <option value="supervision">
              Supervisión
            </option>

            <option value="diseno-planeacion">
              Diseño y planeación
            </option>
          </select>
        </div>

        <div class="contact__field">
          <label for="message">
            Cuéntanos sobre tu proyecto
          </label>

          <textarea
            id="message"
            name="message"
            rows="6"
            placeholder="Describe brevemente qué necesitas..."
          ></textarea>
        </div>

        <button class="contact__submit" type="submit">
          Enviar solicitud

          <Send
            size={18}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </button>
      </form>
    </div>
  </Container>
</section>