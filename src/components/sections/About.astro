---
import Container from "../common/Container.astro";
import SectionTitle from "../common/SectionTitle.astro";
import Card from "../ui/Card.astro";

import {
  ShieldCheck,
  Users,
  Clock3,
  Leaf,
} from "lucide-astro";

import { features } from "../../data/features";

const featureIcons = [
  ShieldCheck,
  Users,
  Clock3,
  Leaf,
];
---

<section class="about section" id="nosotros">
  <Container class="container--wide">
    <SectionTitle
      eyebrow="¿Por qué elegirnos?"
      title="Construimos confianza desde el primer día"
      description="Nuestro compromiso es ofrecer soluciones confiables, eficientes y de alta calidad en cada proyecto."
    />

    <div class="about__grid">
      {
        features.map((feature, index) => {
          const Icon = featureIcons[index];

          return (
            <Card hover class="about__card">
              <div class="about__icon" aria-hidden="true">
                <Icon
                  size={30}
                  strokeWidth={1.8}
                  absoluteStrokeWidth
                />
              </div>

              <h3 class="about__title">
                {feature.title}
              </h3>

              <p class="about__description">
                {feature.description}
              </p>
            </Card>
          );
        })
      }
    </div>
  </Container>
</section>

<style>
  .about {
    background-color: var(--color-white);
  }

  .about__grid {
    display: grid;
    gap: var(--space-6);

    margin-top: var(--space-7);
  }

  .about__card {
    height: 100%;
  }

  .about__icon {
    display: grid;
    place-items: center;

    width: 3.5rem;
    height: 3.5rem;

    margin-bottom: var(--space-5);

    background-color: var(--color-secondary-light);
    border-radius: var(--radius-md);

    color: var(--color-secondary);
  }

  .about__title {
    margin-bottom: var(--space-3);

    font-size: var(--font-size-lg);
  }

  .about__description {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .about__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .about__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>