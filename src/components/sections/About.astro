---
import "../../styles/components/about.css";

import Container from "../common/Container.astro";
import SectionTitle from "../common/SectionTitle.astro";
import Card from "../ui/Card.astro";

import {
  ShieldCheck,
  Users,
  Clock3,
  Leaf,
} from "lucide-astro";

import { features } from "../../data/features";

const featureIcons = [
  ShieldCheck,
  Users,
  Clock3,
  Leaf,
];
---

<section
  class="about section"
  id="nosotros"
  data-reveal
>
  <Container class="container--wide">

    <div class="about__heading">
      <SectionTitle
        eyebrow="¿Por qué elegirnos?"
        title="Construimos confianza desde el primer día"
        description="Nuestro compromiso es ofrecer soluciones confiables, eficientes y de alta calidad en cada proyecto."
      />
    </div>

    <div class="about__grid">
      {
        features.map((feature, index) => {
          const Icon = featureIcons[index];

          return (
            <Card hover class="about__card">
              <div class="about__icon" aria-hidden="true">
                <Icon
                  size={30}
                  strokeWidth={1.8}
                  absoluteStrokeWidth
                />
              </div>

              <h3 class="about__title">
                {feature.title}
              </h3>

              <p class="about__description">
                {feature.description}
              </p>
            </Card>
          );
        })
      }
    </div>

    <div class="about__more">
      <a href="/nosotros" class="about__link">
          Conoce más sobre CIRCROM
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </Container>
</section>