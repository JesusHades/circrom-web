---
import "../../styles/components/projects.css";

import Container from "../common/Container.astro";
import SectionTitle from "../common/SectionTitle.astro";
import Badge from "../ui/Badge.astro";

import { projects } from "../../data/projects";
---

<section class="projects section section--alternate" id="proyectos">
  <Container>
    <SectionTitle
      eyebrow="Proyectos destacados"
      title="Hacemos realidad cada visión"
      description="Una selección de proyectos desarrollados por CIRCROM con atención al detalle, funcionalidad y calidad."
    />

    <div class="projects__grid">
      {
        projects.map((project) => (
          <article class="project-card">
            <div class="project-card__image">
              <span>Imagen del proyecto</span>
            </div>

            <div class="project-card__content">
              <Badge variant="secondary">
                {project.category}
              </Badge>

              <h3 class="project-card__title">
                {project.title}
              </h3>

              <p class="project-card__type">
                {project.type}
              </p>

              <a class="project-card__link" href="#">
                Ver proyectos
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>