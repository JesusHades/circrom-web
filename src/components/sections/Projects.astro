---
import "../../styles/components/projects.css";

import Container from "../common/Container.astro";
import SectionTitle from "../common/SectionTitle.astro";
import Badge from "../ui/Badge.astro";

import { featuredProjects } from "../../data/featuredProjects";
---

<section
  class="projects section section--alternate"
  id="proyectos"
>
  <Container class="container--wide">
    <SectionTitle
      eyebrow="Proyectos destacados"
      title="Hacemos realidad cada visión"
      description="Una selección de proyectos desarrollados por CIRCROM con atención al detalle, funcionalidad y calidad."
    />

    <div class="projects__grid">
      {
        featuredProjects.map((project) => (
          <article class="project-card">
            <a
              class="project-card__image"
              href="/proyectos"
              aria-label="Conocer los proyectos de CIRCROM"
            >
              <img
                src={project.image}
                alt={project.title}
                loading="lazy"
              />
            </a>

            <div class="project-card__content">
              <Badge variant="secondary">
                {project.category}
              </Badge>

              <h3 class="project-card__title">
                {project.title}
              </h3>

              <p class="project-card__type">
                {project.type}
              </p>

              <a
                class="project-card__link"
                href="/proyectos"
              >
                Ver proyectos
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="projects__more">
      <a
        href="/proyectos"
        class="projects__more-link"
      >
        Conoce todos nuestros proyectos
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </Container>
</section>