---
import "../../styles/components/hero.css";

import Container from "../common/Container.astro";
import Button from "../ui/Button.astro";
---

<section class="hero">
  <Container class="container--wide">
    <div class="hero__grid">
      <div class="hero__content">
        <p class="hero__eyebrow">
          Construcción y remodelación
        </p>

        <h1 class="hero__title">
          Construimos espacios que inspiran
        </h1>

        <p class="hero__description">
          Soluciones integrales en construcción, remodelación y supervisión de
          proyectos con calidad, compromiso y atención al detalle.
        </p>

        <div class="hero__actions">
          <Button href="#proyectos" size="lg">
            Ver proyectos
          </Button>

          <Button href="#nosotros" variant="secondary" size="lg">
            Conocer más
          </Button>
        </div>
      </div>

      <div class="hero__visual">
        <img
          class="hero__image"
          src="/images/hero/hero-main.jpg"
          alt="Proyecto de agencia automotriz realizado por CIRCROM"
        />
      </div>
    </div>
  </Container>
</section>