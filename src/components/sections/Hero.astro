---
import Container from "../common/Container.astro";
import Button from "../ui/Button.astro";
---

<section class="hero">
  <Container class="hero__container">
    <div class="hero__content">
      <p class="hero__eyebrow">
        Construcción y remodelación
      </p>

      <h1 class="hero__title">
        Construimos espacios que inspiran
      </h1>

      <p class="hero__description">
        Soluciones integrales en construcción, remodelación y supervisión de
        proyectos con calidad y compromiso.
      </p>

      <div class="hero__actions">
        <Button href="#proyectos" size="lg">
          Ver proyectos
        </Button>

        <Button href="#nosotros" variant="secondary" size="lg">
          Conocer más
        </Button>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <span>Imagen del proyecto</span>
    </div>
  </Container>
</section>

<style>
  .hero {
    background-color: var(--color-background-alt);
  }

  .hero__container {
    display: grid;
    align-items: center;
    gap: var(--space-7);

    min-height: calc(100vh - 5rem);
    padding-block: var(--space-8);
  }

  .hero__content {
    max-width: 40rem;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-3);

    color: var(--color-primary);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);

    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__title {
    font-size: var(--font-size-3xl);
    line-height: var(--line-height-tight);
  }

  .hero__description {
    max-width: 36rem;

    margin-top: var(--space-5);

    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);

    margin-top: var(--space-6);
  }

  .hero__visual {
    display: grid;
    place-items: center;

    min-height: 20rem;

    background-color: var(--color-gray-200);
    border-radius: var(--radius-lg);

    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .hero__title {
      font-size: var(--font-size-4xl);
    }

    .hero__visual {
      min-height: 28rem;
    }
  }

  @media (min-width: 64rem) {
    .hero__container {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--space-8);

      min-height: calc(100vh - 5.5rem);
    }

    .hero__title {
      font-size: var(--font-size-5xl);
    }

    .hero__visual {
      min-height: 36rem;
    }
  }
</style>