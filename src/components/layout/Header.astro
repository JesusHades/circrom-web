---
import Container from "../common/Container.astro";
import Navbar from "./Navbar.astro";
import Button from "../ui/Button.astro";
---

<header class="header">
  <Container class="header__container">
    <a class="header__logo" href="/" aria-label="CIRCROM - Inicio">
      <img
        src="/public/images/logo/circrom-logo.jpeg"
        alt="CIRCROM"
        width="180"
        height="60"
      />
    </a>

    <Navbar />

    <div class="header__actions">
      <Button href="#contacto" size="sm">
        Cotizar proyecto
      </Button>
    </div>

    <button
      class="header__menu"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </Container>
</header>

<style>
  .header {
    position: relative;
    z-index: var(--z-sticky);

    width: 100%;

    background-color: var(--color-white);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: 5rem;
  }

  .header__logo {
    display: block;
    flex-shrink: 0;
  }

  .header__logo img {
    width: auto;
    height: 2.5rem;
  }

  .header__actions {
    display: none;
  }

  .header__menu {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;

    width: 2.5rem;
    height: 2.5rem;

    padding: 0;

    background: transparent;
    border: 0;

    color: var(--color-text);
  }

  .header__menu span {
    display: block;

    width: 1.5rem;
    height: 2px;

    margin-inline: auto;

    background-color: currentColor;

    transition: transform var(--transition-normal);
  }

  @media (min-width: 64rem) {
    .header__container {
      min-height: 5.5rem;
    }

    .header__logo img {
      height: 3rem;
    }

    .header__actions {
      display: block;
    }

    .header__menu {
      display: none;
    }
  }
</style>