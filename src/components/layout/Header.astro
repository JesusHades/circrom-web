---
import "../../styles/components/header.css";

import Container from "../common/Container.astro";
import Navbar from "./Navbar.astro";
---

<header class="header">
  <Container class="header__container">
    <a
      class="header__logo"
      href="/"
      aria-label="CIRCROM - Inicio"
    >
      <img
        src="/images/logo/circrom-logo.png"
        alt="CIRCROM"
        width="180"
        height="60"
      />
    </a>

    <Navbar />

    <button
      class="header__menu"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </Container>
</header>

<script>
import "../../scripts/header.js";
</script>