---
interface Props {
  padding?: "sm" | "md" | "lg";
  hover?: boolean;
  class?: string;
}

const {
  padding = "md",
  hover = false,
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "card",
    `card--${padding}`,
    { "card--hover": hover },
    className,
  ]}
>
  <slot />
</div>

<style>
  .card {
    background-color: var(--color-white);

    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);

    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal),
      border-color var(--transition-normal);
  }

  /* Padding */

  .card--sm {
    padding: var(--space-4);
  }

  .card--md {
    padding: var(--space-5);
  }

  .card--lg {
    padding: var(--space-6);
  }

  /* Interactive state */

  .card--hover:hover {
    transform: translateY(-0.25rem);

    border-color: transparent;

    box-shadow: var(--shadow-md);
  }
</style>